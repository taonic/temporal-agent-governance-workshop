# Copy to .env and adjust. Real environment variables override this file.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=travel-agent

# The model: any OpenAI-compatible endpoint. For a live session, the shared GPU endpoint's
# values (scripts/gpu_endpoint.py up prints them).
LLM_MODE=openai              # or "scripted": a fixed travel agent, no model needed
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5-9b
LLM_API_KEY=unused
# LLM_REASONING_EFFORT=none  # turn thinking off (Qwen on Ollama); the GPU endpoint already does
#
# Gemini instead: its OpenAI-compatible API. Uses GEMINI_API_KEY from your environment if set,
# else LLM_API_KEY. Comment out the four lines above.
# LLM_MODE=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# How long the simulated travel APIs take to answer, in seconds
TOOL_LATENCY_S=1.5

# Where a browser reaches the Temporal UI
TEMPORAL_UI_URL=http://localhost:8233
