    },
    {
      "id": "query-3",
      "from": "ui",
      "to": "server",
      "y": 470,
      "label": "query boarded",
      "variant": "default"
    },
    {
      "id": "answer-3",
      "from": "second",
      "to": "ui",
      "y": 505,
      "label": "boarded: 7, then 8…",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "server",
      "from": 170,
      "to": 475,
      "type": "database"
    },
    {
      "participant": "first",
      "from": 170,
      "to": 245,
      "type": "backend"
    },
    {
      "participant": "second",
      "from": 370,
      "to": 510,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Rebuilt, not saved",
      "items": [
        "on_board lives only in a worker's memory",
        "The history records the start and every timer that fired",
        "A new worker replays them and gets the same count back"
      ]
    }
  ]
}
