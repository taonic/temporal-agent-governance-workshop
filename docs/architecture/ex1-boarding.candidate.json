      "type": "database",
      "label": "History",
      "sublabel": "Temporal server"
    },
    {
      "id": "first",
      "type": "backend",
      "label": "Worker",
      "sublabel": "on_board = 7, in memory"
    },
    {
      "id": "second",
      "type": "backend",
      "label": "New worker",
      "sublabel": "started after"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 260,
      "label": "1. Boarding: one passenger every 2s"
    },
    {
      "from": 270,
      "to": 345,
      "label": "2. Worker stopped: nothing holds the count"
    },
    {
      "from": 355,
      "to": 520,
      "label": "3. A new worker replays the history"
    }
  ],
  "messages": [
    {
      "id": "next",
      "from": "first",
      "to": "server",
