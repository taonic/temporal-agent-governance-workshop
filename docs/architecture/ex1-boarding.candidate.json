{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Rebuilt from the history",
    "animation": "trace",
    "quality_profile": "showcase",
    "output": "docs/architecture/ex1-boarding.html",
    "legend": {
      "entries": {
        "frontend": {
          "label": "What you see"
        },
        "security": {
          "label": "No answer"
        },
        "database": {
          "label": "History"
        },
        "backend": {
          "label": "Worker"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Temporal UI · Queries tab"
    },
    {
      "id": "temporal",
      "label": "Temporal server"
    },
    {
      "id": "workers",
      "label": "Workers"
    }
  ],
  "phases": [
    {
      "id": "boarding",
      "label": "1 · Boarding",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "stopped",
      "label": "2 · Worker stopped",
      "fromCol": 2,
      "toCol": 3,
      "variant": "dashed"
    },
    {
      "id": "replay",
      "label": "3 · A new worker replays",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "first",
    "history",
    "second",
    "answer-3"
  ],
  "nodes": [
    {
      "id": "answer-1",
      "lane": "ui",
      "col": 0,
      "type": "frontend",
      "label": "Query boarded",
      "sublabel": "answered: 7",
      "width": 160
    },
    {
      "id": "timeout",
      "lane": "ui",
      "col": 3,
      "type": "security",
      "label": "Query boarded",
      "sublabel": "timed out: no worker",
      "width": 160
    },
    {
      "id": "answer-3",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "Query boarded",
      "sublabel": "answered: 7, then 8",
      "width": 160
    },
    {
      "id": "history",
      "lane": "temporal",
      "col": 2,
      "type": "database",
      "label": "History",
      "sublabel": "start + 7 timers fired",
      "width": 160
    },
    {
      "id": "first",
      "lane": "workers",
      "col": 0,
      "type": "backend",
      "label": "Worker",
      "sublabel": "on_board = 7, in memory",
      "width": 160
    },
    {
      "id": "second",
      "lane": "workers",
      "col": 4,
      "type": "backend",
      "label": "New worker",
      "sublabel": "replays: on_board = 7",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "answers-1",
      "from": "first",
      "to": "answer-1",
      "label": "answers",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "timer",
      "from": "first",
      "to": "history",
      "label": "each timer fired",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "left"
    },
    {
      "id": "no-worker",
      "from": "history",
      "to": "timeout",
      "label": "nobody holds the count",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "replays",
      "from": "history",
      "to": "second",
      "label": "the history, replayed",
      "variant": "emphasis"
    },
    {
      "id": "answers-3",
      "from": "second",
      "to": "answer-3",
      "label": "answers",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Rebuilt, not saved",
      "items": [
        "on_board lives only in a worker's memory",
        "The history records the start and every timer that fired",
        "A new worker replays them and gets the same count back"
      ]
    }
  ]
}
