    },
    {
      "id": "query-1",
      "from": "ui",
      "to": "server",
      "y": 205,
      "label": "query boarded",
      "variant": "default"
    },
    {
      "id": "answer-1",
      "from": "first",
      "to": "ui",
      "y": 240,
      "label": "boarded: 7",
      "variant": "return"
    },
    {
      "id": "query-2",
      "from": "ui",
      "to": "server",
      "y": 290,
      "label": "query boarded",
      "variant": "default"
    },
    {
      "id": "timeout",
      "from": "server",
      "to": "ui",
      "y": 325,
      "label": "timed out: no worker",
