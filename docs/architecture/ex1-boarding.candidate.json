{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Exercise 1: the count is rebuilt from the history, not saved",
    "output": "docs/architecture/ex1-boarding.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "emphasis": {
          "label": "recorded in the history"
        },
        "default": {
          "label": "asked"
        },
        "return": {
          "label": "answered"
        },
        "dashed": {
          "label": "no answer"
        }
      }
    }
  },
  "participants": [
    {
      "id": "ui",
      "type": "frontend",
      "label": "Temporal UI",
      "sublabel": "Queries tab"
    },
    {
