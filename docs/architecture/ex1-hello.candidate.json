{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "History is the state",
    "animation": "trace",
    "quality_profile": "showcase",
    "output": "docs/architecture/ex1-hello.html",
    "legend": {
      "entries": {
        "external": {
          "label": "You"
        },
        "frontend": {
          "label": "What you see"
        },
        "database": {
          "label": "History"
        },
        "backend": {
          "label": "Workflow and activity"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "you",
      "label": "You"
    },
    {
      "id": "temporal",
      "label": "Temporal server"
    },
    {
      "id": "worker",
      "label": "hello-worker"
    }
  ],
  "phases": [
    {
      "id": "start",
      "label": "You start it",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "record",
      "label": "Temporal records it",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "run",
      "label": "A worker runs it",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "starter",
    "history",
    "trip",
    "lookup"
  ],
  "nodes": [
    {
      "id": "starter",
      "lane": "you",
      "col": 0,
      "type": "external",
      "label": "Starter",
      "sublabel": "hello-start SFO JFK",
      "width": 160
    },
    {
      "id": "ui",
      "lane": "you",
      "col": 2,
      "type": "frontend",
      "label": "Temporal UI",
      "sublabel": "Event History · Pending",
      "width": 160
    },
    {
      "id": "history",
      "lane": "temporal",
      "col": 2,
      "type": "database",
      "label": "Workflow history",
      "sublabel": "the start · each result",
      "width": 160
    },
    {
      "id": "trip",
      "lane": "worker",
      "col": 3,
      "type": "backend",
      "label": "HelloTripWorkflow",
      "sublabel": "looks up two airports",
      "width": 160
    },
    {
      "id": "lookup",
      "lane": "worker",
      "col": 5,
      "type": "backend",
      "label": "lookup_airport",
      "sublabel": "FLAKY=1: tries 1–4 fail",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "start",
      "from": "starter",
      "to": "history",
      "label": "start workflow",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "reads",
      "from": "ui",
      "to": "history",
      "label": "reads",
      "variant": "default"
    },
    {
      "id": "tasks",
      "from": "history",
      "to": "trip",
      "label": "tasks · replay",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "execute",
      "from": "trip",
      "to": "lookup",
      "label": "execute_activity",
      "variant": "emphasis"
    },
    {
      "id": "result",
      "from": "lookup",
      "to": "history",
      "label": "try 5: result recorded",
      "variant": "dashed",
      "role": "return",
      "fromSide": "top",
      "toSide": "right"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Retries are policy, not code",
      "items": [
        "FLAKY=1 fails 4 of every 5 attempts",
        "RetryPolicy waits 2s, ×2, at most 6s",
        "Attempt 5 gets through: about 40s a trip"
      ]
    },
    {
      "dot": "cyan",
      "title": "The history, not the worker, holds the run",
      "items": [
        "The server records the start and each activity's result",
        "A new worker replays the history and carries on",
        "No worker: the work waits, and nothing is lost"
      ]
    }
  ]
}
