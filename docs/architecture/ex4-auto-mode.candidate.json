  "cards": [
    {
      "dot": "violet",
      "title": "Plain Cedar, then temporal",
      "items": [
        "A plain rule sees only the call: any flight for Ada, any day",
        "A temporal rule looks back: a flight runs only if an earlier trip form named its passenger and date"
      ]
    },
    {
      "dot": "amber",
      "title": "Only bookings are judged",
      "items": [
        "The script and its searches run unattended",
        "Anything no rule permits is refused, and the model is told why"
      ]
    }
