{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Every step is an activity",
    "animation": "trace",
    "quality_profile": "showcase",
    "output": "docs/architecture/ex2-session.html",
    "legend": {
      "entries": {
        "external": {
          "label": "You"
        },
        "backend": {
          "label": "Workflow code"
        },
        "security": {
          "label": "The sandbox"
        },
        "messagebus": {
          "label": "Activity"
        },
        "cloud": {
          "label": "Outside services"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "outside",
      "label": "Outside the worker"
    },
    {
      "id": "activities",
      "label": "travel-worker · activities"
    },
    {
      "id": "workflow",
      "label": "travel-worker · workflow code"
    }
  ],
  "phases": [
    {
      "id": "ask",
      "label": "You ask",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "turn",
      "label": "The model's turn",
      "fromCol": 2,
      "toCol": 2,
      "variant": "dashed"
    },
    {
      "id": "script",
      "label": "The script's calls",
      "fromCol": 3,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "you",
    "workflow",
    "monty",
    "book",
    "api"
  ],
  "nodes": [
    {
      "id": "you",
      "lane": "outside",
      "col": 0,
      "type": "external",
      "label": "You",
      "sublabel": "ask for a trip",
      "width": 160
    },
    {
      "id": "workflow",
      "lane": "workflow",
      "col": 1,
      "type": "backend",
      "label": "TravelAgent",
      "sublabel": "one workflow per session",
      "width": 160
    },
    {
      "id": "monty",
      "lane": "workflow",
      "col": 3,
      "type": "security",
      "label": "Monty sandbox",
      "sublabel": "runs the model's script",
      "width": 160
    },
    {
      "id": "callllm",
      "lane": "activities",
      "col": 2,
      "type": "messagebus",
      "label": "call_llm",
      "sublabel": "one per model turn",
      "width": 160
    },
    {
      "id": "search",
      "lane": "activities",
      "col": 4,
      "type": "messagebus",
      "label": "search_flights",
      "sublabel": "a step in the history",
      "width": 160
    },
    {
      "id": "book",
      "lane": "activities",
      "col": 5,
      "type": "messagebus",
      "label": "book_flight",
      "sublabel": "retried, never repeated",
      "width": 160
    },
    {
      "id": "model",
      "lane": "outside",
      "col": 2,
      "type": "cloud",
      "label": "The model",
      "sublabel": "Gemini · OpenAI API",
      "width": 160
    },
    {
      "id": "api",
      "lane": "outside",
      "col": 5,
      "type": "cloud",
      "label": "Travel API",
      "sublabel": "simulated flights",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "ask",
      "from": "you",
      "to": "workflow",
      "label": "ask",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "each-turn",
      "from": "workflow",
      "to": "callllm",
      "label": "each model turn",
      "variant": "default",
      "fromSide": "top",
      "toSide": "left"
    },
    {
      "id": "chat",
      "from": "callllm",
      "to": "model",
      "label": "chat + tool calls",
      "variant": "default"
    },
    {
      "id": "run-script",
      "from": "workflow",
      "to": "monty",
      "label": "run this script",
      "variant": "emphasis"
    },
    {
      "id": "search-call",
      "from": "monty",
      "to": "search",
      "label": "search_flights(…)",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "book-call",
      "from": "monty",
      "to": "book",
      "label": "book_flight(…)",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "search-api",
      "from": "search",
      "to": "api",
      "variant": "default",
      "fromSide": "top",
      "toSide": "left"
    },
    {
      "id": "book-api",
      "from": "book",
      "to": "api",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Each call the script makes is an activity",
      "items": [
        "Recorded in the session's history",
        "Retried until it succeeds",
        "Never run again once it has"
      ]
    }
  ]
}
