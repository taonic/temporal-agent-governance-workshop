    {
      "id": "gate",
      "lane": "temporal",
      "col": 3,
      "type": "security",
      "label": "Approval gate",
      "sublabel": "approval_policy(): your TODO",
      "width": 176
    },
    {
      "id": "tools",
      "lane": "temporal",
      "col": 5,
      "type": "backend",
      "label": "Tool calls run",
      "sublabel": "search · script · board",
      "width": 160
    },
    {
      "id": "model",
      "lane": "outside",
      "col": 2,
      "type": "cloud",
      "label": "The model",
      "sublabel": "decides the next call",
      "width": 160
    },
    {
      "id": "api",
      "lane": "outside",
      "col": 5,
      "type": "cloud",
      "label": "Travel API",
      "sublabel": "simulated flights",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "ask",
      "from": "you",
      "to": "session",
      "variant": "emphasis"
    },
    {
      "id": "each-turn",
      "from": "session",
      "to": "model",
      "label": "each turn",
      "variant": "default"
    },
    {
      "id": "tool-calls",
      "from": "model",
      "to": "gate",
      "label": "tool calls",
      "variant": "emphasis"
    },
    {
      "id": "allowed",
      "from": "gate",
      "to": "tools",
      "label": "allowed",
      "variant": "emphasis"
    },
    {
      "id": "calls",
      "from": "tools",
      "to": "api",
      "variant": "default"
    },
    {
      "id": "waits",
      "from": "gate",
      "to": "card",
      "label": "a booking waits",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "decides",
      "from": "card",
      "to": "update",
      "label": "approve / reject",
      "variant": "emphasis"
    },
    {
      "id": "decision",
      "from": "update",
      "to": "gate",
      "label": "decision",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "What you write",
      "items": [
        "approval_policy() for approve_bookings: which calls run unattended",
        "Lookups, the script and the trip board run; bookings wait for you"
      ]
    },
    {
      "dot": "rose",
      "title": "What the harness already does",
      "items": [
        "A decision is a Temporal Update: its validator refuses a second click or a stale card",
        "The session waits durably: no worker needed, for seconds or days",
        "Every decision is in the history, next to the booking it allowed"
      ]
    }
  ]
}
