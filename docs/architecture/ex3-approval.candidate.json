    "legend": {
      "entries": {
        "external": {
          "label": "You"
        },
        "frontend": {
          "label": "What you see"
        },
        "backend": {
          "label": "Runs on Temporal"
        },
        "security": {
          "label": "The approval gate"
        },
        "cloud": {
          "label": "Outside services"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "outside",
      "label": "Outside Temporal"
    },
    {
      "id": "temporal",
      "label": "Temporal · every step durable"
    },
    {
      "id": "server",
      "label": "Temporal Server"
    }
  ],
  "phases": [
    {
      "id": "ask",
      "label": "You ask",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "check",
      "label": "Each call is checked",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "wait",
      "label": "A booking waits",
      "fromCol": 4,
      "toCol": 4,
      "variant": "dashed"
    },
    {
      "id": "run",
      "label": "Allowed calls run",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "you",
    "session",
    "model",
    "gate",
    "tools",
    "api"
  ],
  "nodes": [
    {
      "id": "you",
      "lane": "outside",
      "col": 0,
      "type": "external",
      "label": "You",
      "sublabel": "ask for a trip",
      "width": 160
    },
    {
      "id": "card",
      "lane": "outside",
      "col": 3,
      "type": "frontend",
      "label": "Approval card",
      "sublabel": "approve or reject",
      "width": 160
    },
    {
      "id": "session",
      "lane": "temporal",
      "col": 1,
      "type": "backend",
      "label": "Agent session",
      "sublabel": "posture: approve_bookings",
      "width": 160
    },
    {
      "id": "update",
      "lane": "server",
      "col": 4,
      "type": "backend",
      "label": "tool_approval",
      "sublabel": "validated, then recorded",
      "width": 160
