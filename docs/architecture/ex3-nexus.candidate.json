  "cards": [
    {
      "dot": "cyan",
      "title": "Three directions, one endpoint",
      "items": [
        "Agent → agent: TravelAgent's ask_concierge calls ask, and ConciergeAgent answers",
        "Agent → workflow: TravelAgent's reserve_table calls reserve_table, served by TableReservation",
        "Workflow → agent: TripBriefing, with no model, calls the same ask",
        "Solid arrows: the call going out; dashed violet arrows: the result coming back through the history and the task queue"
      ]
    },
    {
      "dot": "violet",
      "title": "The durable guarantee",
      "items": [
        "Once a workflow makes the call, an answer, a failure or a timeout comes back and lands in its history",
        "Temporal delivers the call, retrying while the concierge is away; the endpoint is a durable route, registered once",
        "The answer comes back through a callback, recorded as NexusOperationCompleted even while the caller's worker is down; queue dispatch delivers it once a worker polls",
        "The caller's history records the call; the concierge's history holds the whole run",
        "Nexus Endpoint → task queue → the concierge's worker → Nexus Service → operation: where calls go, who pulls them, the contract, one call"
      ]
    }
  ]
