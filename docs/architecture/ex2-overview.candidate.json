    {
      "id": "tools",
      "lane": "temporal",
      "col": 5,
      "type": "backend",
      "label": "Tool calls",
      "sublabel": "search · book flights",
      "width": 160
    },
    {
      "id": "history",
      "lane": "history",
      "col": 2,
      "type": "database",
      "label": "Event history",
      "sublabel": "every step, recorded",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "message",
      "from": "you",
      "to": "session",
      "label": "message",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "top"
    },
    {
      "id": "each-turn",
      "from": "session",
      "to": "llm",
      "label": "each turn",
      "variant": "emphasis"
    },
    {
      "id": "ask-model",
      "from": "llm",
      "to": "model",
      "label": "ask",
      "variant": "default"
    },
    {
      "id": "script",
      "from": "llm",
      "to": "monty",
      "label": "a script",
      "variant": "emphasis"
    },
    {
      "id": "each-call",
      "from": "monty",
      "to": "tools",
      "label": "each call",
      "variant": "emphasis"
    },
    {
      "id": "calls-api",
      "from": "tools",
      "to": "api",
      "variant": "default"
    },
    {
      "id": "recorded",
      "from": "session",
      "to": "history",
      "label": "recorded",
      "variant": "dashed",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "results",
      "from": "tools",
      "to": "history",
      "label": "results",
      "variant": "dashed",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "right"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Where Temporal fits",
      "items": [
        "Each conversation is a workflow: it waits, retries and survives crashes",
        "Model calls and tool calls are activities, recorded in the history",
        "A restart replays the history: nothing lost, nothing done twice"
      ]
    },
    {
      "dot": "rose",
      "title": "Code Mode",
      "items": [
        "The model writes a short script, not one tool call at a time",
        "Monty runs it inside the workflow: no files, no network",
        "Each call the script makes is a tool call, an activity"
      ]
    }
  ]
}
