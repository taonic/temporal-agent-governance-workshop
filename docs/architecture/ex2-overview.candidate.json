    },
    {
      "id": "api",
      "lane": "outside",
      "col": 5,
      "type": "cloud",
      "label": "Travel API",
      "sublabel": "simulated flights",
      "width": 160
    },
    {
      "id": "session",
      "lane": "temporal",
      "col": 1,
      "type": "backend",
      "label": "Agent session",
      "sublabel": "a Temporal workflow",
      "width": 160
    },
    {
      "id": "llm",
      "lane": "temporal",
      "col": 2,
      "type": "backend",
      "label": "Model call",
      "sublabel": "each turn, an activity",
