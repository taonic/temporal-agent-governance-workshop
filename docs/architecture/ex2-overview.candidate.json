          "label": "History"
        },
        "cloud": {
          "label": "Outside services"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "outside",
      "label": "Outside Temporal"
    },
    {
      "id": "temporal",
      "label": "Temporal · every step durable"
    },
    {
      "id": "history",
      "label": "Temporal Server"
    }
  ],
  "phases": [
    {
      "id": "ask",
      "label": "You ask",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "plan",
      "label": "The model plans",
      "fromCol": 2,
      "toCol": 2,
      "variant": "dashed"
    },
    {
      "id": "run",
      "label": "Code Mode runs it",
      "fromCol": 3,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "you",
    "session",
    "llm",
    "monty",
    "tools",
    "api"
  ],
  "nodes": [
    {
      "id": "you",
      "lane": "outside",
      "col": 0,
      "type": "external",
      "label": "You",
      "sublabel": "chat with the agent",
      "width": 160
    },
    {
      "id": "model",
      "lane": "outside",
      "col": 2,
      "type": "cloud",
      "label": "The model",
      "sublabel": "Gemini",
