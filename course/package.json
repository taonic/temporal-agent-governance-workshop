{
  "name": "governed-agents-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser course site for Governed Agents With Temporal, Monty, And Dogwood: the Vue site and the Daytona sandbox runner.",
  "scripts": {
    "content": "node content/build.mjs",
    "dev": "vite --config web/vite.config.mjs --host 127.0.0.1 --port 4173",
    "runner": "node --watch-path=runner runner/server.mjs",
    "runner:tunnel": "./runner-tunnel.sh",
    "build": "vite build --config web/vite.config.mjs",
    "start": "node runner/server.mjs",
    "snapshot": "node snapshot/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "deploy": "cd .. && fly deploy . --config course/fly.toml --dockerfile course/Dockerfile --ignorefile course/.dockerignore --ha=false"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.224.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
