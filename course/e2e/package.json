{
  "name": "governed-agents-course-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end tests for the deployed course site (the live Fly app by default).",
  "scripts": {
    "test": "playwright test",
    "test:public": "playwright test --grep @public",
    "test:auth": "playwright test --grep \"@public|@auth\"",
    "test:sandbox": "playwright test --grep @sandbox",
    "report": "playwright show-report reports/html",
    "summary": "node scripts/summary.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
